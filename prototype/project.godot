; PETRIVERSE — A living journey. Open this project and press F5.
config_version=5

[application]
config/name="Petriverse"
; Keep existing journeys and preferences when the public title changes.
config/use_custom_user_dir=true
config/custom_user_dir_name="Godot/app_userdata/MICROVERSE"
config/custom_user_dir_name.linux="godot/app_userdata/MICROVERSE"
config/custom_user_dir_name.amoeba_playtest="Godot/app_userdata/MICROVERSE Amoeba Practice"
config/custom_user_dir_name.phage_playtest="Godot/app_userdata/MICROVERSE Phage Practice"
config/version="0.2.1"
config/icon="res://assets/organisms/mother.png"
run/main_scene="res://main.tscn"
run/main_scene.amoeba_playtest="res://playtests/amoeba.tscn"
config/name.amoeba_playtest="Petriverse Amoeba Practice"
run/main_scene.phage_playtest="res://playtests/phages.tscn"
config/name.phage_playtest="Petriverse Phage Practice"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/description="Feed. Protect. Evolve. Guide a colony through three living dishes."

[display]
window/size/viewport_width=1280
window/size/viewport_height=900
window/size/window_width_override=1152
window/size/window_height_override=810
window/size/min_width=768
window/size/min_height=540
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.018, 0.034, 0.043, 1)
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true

[physics]
common/physics_ticks_per_second=60
